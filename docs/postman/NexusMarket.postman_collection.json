{
  "info": {
    "name": "NexusMarket",
    "description": "Coleccion generada a partir de los 8 controladores REST reales (27 endpoints): autenticacion JWT, pedidos con items, envio y entrega por item, devoluciones y reembolsos parciales. Ejecute primero Authentication > POST /api/auth/login: el script de prueba guarda la variable {{jwt}}. La aplicacion no emite refresh tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt",
      "value": "PEGUE_AQUI_EL_JWT"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "itemId",
      "value": "1"
    },
    {
      "key": "returnId",
      "value": "1"
    },
    {
      "key": "refundId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.accessToken) {",
                  "  pm.collectionVariables.set('jwt', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@nexusmarket.local\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "200 accessToken/tokenType/expiresIn (guarda {{jwt}}) | 400 cuerpo invalido | 401 credenciales invalidas (mensaje generico)"
          }
        }
      ]
    },
